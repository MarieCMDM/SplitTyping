{
  "version": 1,
  "id": "it",
  "label": "Italian",
  "recommendedStandard": "iso",
  "legends": {
    "Backquote": { "base": "\\", "shift": "|" },
    "Digit1": { "base": "1", "shift": "!" }, "Digit2": { "base": "2", "shift": "\"" },
    "Digit3": { "base": "3", "shift": "£" }, "Digit4": { "base": "4", "shift": "$" },
    "Digit5": { "base": "5", "shift": "%" }, "Digit6": { "base": "6", "shift": "&" },
    "Digit7": { "base": "7", "shift": "/" }, "Digit8": { "base": "8", "shift": "(" },
    "Digit9": { "base": "9", "shift": ")" }, "Digit0": { "base": "0", "shift": "=" },
    "Minus": { "base": "'", "shift": "?" }, "Equal": { "base": "ì", "shift": "^" },
    "KeyQ": { "base": "q" }, "KeyW": { "base": "w" }, "KeyE": { "base": "e", "altGr": "€" },
    "KeyR": { "base": "r" }, "KeyT": { "base": "t" }, "KeyY": { "base": "y" },
    "KeyU": { "base": "u" }, "KeyI": { "base": "i" }, "KeyO": { "base": "o" }, "KeyP": { "base": "p" },
    "BracketLeft": { "base": "è", "shift": "é", "altGr": "[" },
    "BracketRight": { "base": "+", "shift": "*", "altGr": "]" },
    "Backslash": { "base": "ù", "shift": "§" },
    "IntlBackslash": { "base": "<", "shift": ">" },
    "KeyA": { "base": "a" }, "KeyS": { "base": "s" }, "KeyD": { "base": "d" },
    "KeyF": { "base": "f" }, "KeyG": { "base": "g" }, "KeyH": { "base": "h" },
    "KeyJ": { "base": "j" }, "KeyK": { "base": "k" }, "KeyL": { "base": "l" },
    "Semicolon": { "base": "ò", "shift": "ç", "altGr": "@" },
    "Quote": { "base": "à", "shift": "°", "altGr": "#" },
    "KeyZ": { "base": "z" }, "KeyX": { "base": "x" }, "KeyC": { "base": "c" },
    "KeyV": { "base": "v" }, "KeyB": { "base": "b" }, "KeyN": { "base": "n" }, "KeyM": { "base": "m" },
    "Comma": { "base": ",", "shift": ";" }, "Period": { "base": ".", "shift": ":" },
    "Slash": { "base": "-", "shift": "_" },
    "Backspace": { "base": "", "label": "backspace" }, "Tab": { "base": "\t", "label": "tab" },
    "CapsLock": { "base": "", "label": "caps lock" }, "Enter": { "base": "\n", "label": "enter" },
    "ShiftLeft": { "base": "", "label": "shift" }, "ShiftRight": { "base": "", "label": "shift" },
    "ControlLeft": { "base": "", "label": "ctrl" }, "ControlRight": { "base": "", "label": "ctrl" },
    "AltLeft": { "base": "", "label": "alt" }, "AltRight": { "base": "", "label": "altgr" },
    "Space": { "base": " ", "label": "space" },
    "Insert": { "base": "", "label": "ins" }, "Home": { "base": "", "label": "home" },
    "PageUp": { "base": "", "label": "pgup" }, "Delete": { "base": "", "label": "del" },
    "End": { "base": "", "label": "end" }, "PageDown": { "base": "", "label": "pgdn" },
    "ArrowLeft": { "base": "", "label": "←" }, "ArrowDown": { "base": "", "label": "↓" },
    "ArrowRight": { "base": "", "label": "→" }, "ArrowUp": { "base": "", "label": "↑" }
  }
}
